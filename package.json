{
    "name": "bchess",
    "private": true,
    "scripts": {
        "build": "dotenv -e .env -- turbo build",
        "dev": "dotenv -e .env -- turbo dev",
        "test": "dotenv -e .env -- turbo test --filter=@bchess/shared",
        "lint": "turbo lint",
        "dev:web": "dotenv -e .env -- pnpm --filter ./apps/web dev",
        "db:generate": "pnpm --filter ./packages/db generate",
        "db:migrate": "dotenv -e .env -- pnpm --filter ./packages/db migrate",
        "db:push": "dotenv -e .env -- pnpm --filter ./packages/db push",
        "db:studio": "dotenv -e .env -- pnpm --filter ./packages/db studio"
    },
    "packageManager": "pnpm@10.32.1",
    "dependencies": {
        "next": "16.1.6"
    },
    "devDependencies": {
        "dotenv-cli": "^11.0.0",
        "turbo": "^2.10.7"
    },
    "pnpm": {
        "overrides": {
            "drizzle-orm": "0.45.2",
            "typescript": "^5.7.3"
        }
    }
}
