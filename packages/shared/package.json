{
    "name": "@bchess/shared",
    "version": "1.0.0",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "lint": "eslint src/**/*.ts --fix",
        "test": "jest"
    },
    "devDependencies": {
        "@bchess/eslint-config": "workspace:*",
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.1",
        "@bchess/ts-config": "workspace:*",
        "@types/jest": "^30.0.0",
        "babel-jest": "^30.4.1",
        "eslint": "^10.8.1",
        "jest": "^30.4.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@bchess/db": "workspace:^",
        "chess.js": "^1.4.0",
        "drizzle-orm": "^0.30.0",
        "drizzle-zod": "^0.8.3",
        "zod": "^4.3.6"
    }
}
