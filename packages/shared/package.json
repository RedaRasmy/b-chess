{
    "name": "@bchess/shared",
    "version": "1.0.0",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "lint": "eslint src/**/*.ts --fix && tsc --noEmit",
        "type-check": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@bchess/eslint-config": "workspace:*",
        "@bchess/ts-config": "workspace:*",
        "eslint": "^10.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@bchess/db": "workspace:^",
        "chess.js": "^1.4.0",
        "drizzle-orm": "^0.30.0",
        "drizzle-zod": "^0.8.3",
        "zod": "^4.3.6"
    }
}
