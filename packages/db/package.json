{
    "name": "@bchess/db",
    "version": "1.0.0",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./tables": {
            "require": {
                "types": "./dist/schema/index.d.ts",
                "default": "./dist/schema/index.js"
            },
            "import": {
                "types": "./dist/schema/index.d.mts",
                "default": "./dist/schema/index.mjs"
            }
        }
    },
    "scripts": {
        "build": "tsup src/index.ts src/schema/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts src/schema/index.ts --format cjs,esm --dts --watch",
        "lint": "tsc --noEmit",
        "type-check": "tsc --noEmit",
        "push": "npx drizzle-kit push",
        "generate": "npx drizzle-kit generate",
        "migrate": "npx drizzle-kit migrate",
        "studio": "npx drizzle-kit studio"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.32.1",
    "devDependencies": {
        "@bchess/ts-config": "workspace:*",
        "@types/node": "^26.1.1",
        "drizzle-kit": "^0.31.9",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "chess.js": "^1.4.0",
        "dotenv": "^17.4.1",
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.8"
    }
}
