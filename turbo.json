{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "globalEnv": ["DATABASE_URL"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "! .next/cache/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "env": [
                "FRONTEND_URL",
                "PORT",
                "BETTER_AUTH_URL",
                "GITHUB_CLIENT_ID",
                "GITHUB_CLIENT_SECRET",
                "GOOGLE_CLIENT_ID",
                "GOOGLE_CLIENT_SECRET",
                "NODE_ENV"
            ]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "type-check": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": [],
            "env": ["TEST_DATABASE_URL"]
        },
        "ete": {
            "dependsOn": ["^build"]
        }
    }
}
