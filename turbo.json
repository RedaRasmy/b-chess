{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "globalEnv": ["DATABASE_URL"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "! .next/cache/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "type-check": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        }
    }
}
